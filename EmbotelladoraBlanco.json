    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst registrosValidos = [];\nconst registrosDescartados = [];\n\nfor (const item of items) {\n  const registro = item.json;\n  const telefonoOriginal = registro.Telefono;\n\n  if (telefonoOriginal === null || telefonoOriginal === undefined) {\n    registrosDescartados.push({\n      motivo: 'Teléfono vacío',\n      registro,\n    });\n    continue;\n  }\n\n  const telefonoTexto = String(telefonoOriginal).trim();\n\n  if (telefonoTexto === '') {\n    registrosDescartados.push({\n      motivo: 'Teléfono vacío',\n      registro,\n    });\n    continue;\n  }\n\n  // Permite números, +, espacios, guiones, puntos y paréntesis.\n  // Rechaza letras y textos como \"no data\", \"sin teléfono\", etc.\n  const formatoPermitido = /^[+\\d\\s\\-().]+$/;\n\n  if (!formatoPermitido.test(telefonoTexto)) {\n    registrosDescartados.push({\n      motivo: 'El teléfono contiene texto o caracteres no válidos',\n      registro,\n    });\n    continue;\n  }\n\n  const soloDigitos = telefonoTexto.replace(/\\D/g, '');\n\n  if (soloDigitos.length < 8) {\n    registrosDescartados.push({\n      motivo: 'El teléfono tiene menos de 8 dígitos',\n      registro,\n    });\n    continue;\n  }\n\n  registrosValidos.push({\n    ...registro,\n    Telefono: soloDigitos,\n  });\n}\n\nreturn [\n  {\n    json: {\n      registrosValidos,\n      registrosDescartados,\n      cantidadOriginal: items.length,\n      cantidadValida: registrosValidos.length,\n      cantidadDescartada: registrosDescartados.length,\n    },\n  },\n];"
      },
